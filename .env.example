# ══════════════════════════════════════════════════════════════════
#  Voxcraft — AI Voice Cloning & Text-to-Speech — environment config
# ══════════════════════════════════════════════════════════════════

# ── App / environment ─────────────────────────────────────
# production  → fail-fast: requires Postgres + JWT_SECRET + ELEVENLABS_API_KEY
# development → allows SQLite, demo gTTS fallback, relaxed secrets
APP_ENV=production
APP_NAME=Voxcraft
DEBUG=false

# ── Database ───────────────────────────────────────────────
# PostgreSQL connection string. In Railway reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/voiceclone

# ── Auth ───────────────────────────────────────────────────
# ARBITRARY long random string for signing JWTs. Use a random secret.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Storage ────────────────────────────────────────────────
# In Railway point this at a mounted volume, e.g. /data/uploads
UPLOAD_DIR=./uploads

# ── AI voice engine (ElevenLabs) — REQUIRED in production ──
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── OpenAI agent (Script Studio) — optional ────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Rate limiting ──────────────────────────────────────────
# TTS generations per minute per user
RATE_LIMIT_MINUTE=20

# ── CORS / frontend ────────────────────────────────────────
# Your deployed SPA origin
FRONTEND_URL=http://localhost:5173

# ── Frontend build ─────────────────────────────────────────
# Public URL of the backend API (used by the SPA and nginx proxy).
# Leave empty for same-origin (nginx proxies /api and /uploads).
BACKEND_API_URL=