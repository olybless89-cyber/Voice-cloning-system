# ══════════════════════════════════════════════════════════════════
#  Voxcraft — AI Voice Cloning & Text-to-Speech — environment config
# ══════════════════════════════════════════════════════════════════

# ── App / environment ─────────────────────────────────────
# production  → requires Postgres + JWT_SECRET; TTS works out of the box via
#               the free edge-tts engine (no key needed)
# development → allows SQLite, relaxed secrets
APP_ENV=production
APP_NAME=Voxcraft
DEBUG=false

# ── Database ───────────────────────────────────────────────
# PostgreSQL connection string. In Railway reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/voiceclone

# ── Auth ───────────────────────────────────────────────────
# ARBITRARY long random string for signing JWTs. Use a random secret.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Storage ────────────────────────────────────────────────
# In Railway point this at a mounted volume, e.g. /data/uploads
UPLOAD_DIR=./uploads

# ── AI voice engine ─────────────────────────────────────────
# Optional. When empty (recommended for a no-cost setup), the app uses the FREE
# no-key edge-tts engine (Microsoft Edge neural voices) for text-to-speech.
# Set ELEVENLABS_API_KEY only when you want higher-quality neural TTS and true
# per-user voice cloning.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Default edge-tts voice used for TTS when no ElevenLabs key is set.
EDGE_VOICE=en-US-AriaNeural

# ── OpenAI agent (Script Studio) — optional ────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Rate limiting ──────────────────────────────────────────
# TTS generations per minute per user
RATE_LIMIT_MINUTE=20

# ── CORS / frontend ────────────────────────────────────────
# Your deployed SPA origin
FRONTEND_URL=http://localhost:5173

# ── Frontend build ─────────────────────────────────────────
# Public URL of the backend API (used by the SPA and nginx proxy).
# Leave empty for same-origin (nginx proxies /api and /uploads).
BACKEND_API_URL=