# ── Backend ────────────────────────────────────────────────
# PostgreSQL connection string (Railway provides this for the db service)
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/voiceclone
# Arbitrary long random string for signing JWTs
JWT_SECRET=change-me-to-a-long-random-string
# Optional: enable real neural TTS + voice cloning via ElevenLabs
ELEVENLABS_API_KEY=
# Directory where audio is stored (set to /data/uploads in prod with a volume)
UPLOAD_DIR=./uploads
# Origin allowed for CORS (your deployed SPA URL)
FRONTEND_URL=http://localhost:5173

# ── Frontend ───────────────────────────────────────────────
# Public URL of the backend API (used by the SPA and nginx proxy)
BACKEND_API_URL=http://localhost:8000